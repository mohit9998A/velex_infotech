# -----------------------------------------------------------------------------
# Velex Infotech — Environment Variables Configuration Template
# Copy this file to `.env.local` for local development.
# -----------------------------------------------------------------------------

# MongoDB Configuration for Blog Backend
MONGODB_USERNAME=velexinfotech_db_user
MONGODB_PASSWORD=your_mongodb_password_here
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/velex_infotech?retryWrites=true&w=majority
MONGODB_DB=velex_infotech

# Admin Portal Authentication & Session Credentials
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_EMAIL=velexinfotech@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here

# SMTP Configuration (for lead notifications via Nodemailer)
# See lib/mail.ts for full runtime documentation
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=team@velexinfotech.com
SMTP_PASSWORD=your_smtp_password_here

# Lead Routing & Notifications (Optional overrides)
LEAD_FROM_EMAIL=Velex Infotech <team@velexinfotech.com>
LEAD_INBOX=team@velexinfotech.com
LEAD_AUTOREPLY=off
LEAD_MAIL_DISABLED=off

# Rate Limiting Configuration (Optional overrides)
LEAD_MAX_SENDS_PER_HOUR=20
LEAD_MAX_SENDS_PER_DAY=40

# Debug flag (ignored in production)
SMTP_DEBUG=false

# Canonical Site URL (defaults to https://velexinfotech.com in config/site.ts)
NEXT_PUBLIC_APP_URL=https://velexinfotech.com
